# --- Secrets & personal data (NEVER commit) ---
# app_credentials.json: the bundled Last.fm app key/secret (build-time only)
app_credentials.json
# lastfm_session.dat: DPAPI-encrypted per-user session blob
lastfm_session.dat
# lastfm_config.json: local settings (language); no secrets, but per-user
lastfm_config.json
# raw Spotify "extended streaming history" exports
streaming_history_audio_*.json
Streaming_History_*.json
endsong_*.json
# generated exports of your listening history
lastfm_import_*.json

# --- Build artifacts ---
build/
dist/
*.exe
*.spec.bak

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Editor / OS / tooling ---
.claude/
docs/superpowers/
.vscode/
.idea/
.DS_Store
Thumbs.db
